<?xml version='1.0' encoding='utf-8'?>
<robot name="satellite_arm">
  <material name="blue">
    <color rgba="0.1 0.4 0.9 1" />
  </material>
  <material name="orange">
    <color rgba="1 0.5 0.1 1" />
  </material>
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.12" length="0.10" />
      </geometry>
      <material name="blue" />
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.12" length="0.10" />
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0" />
      <inertia ixx="0.0086" ixy="0" ixz="0" iyy="0.0086" iyz="0" izz="0.0144" />
    </inertial>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link" />
    <child link="link1" />
    <origin xyz="0 0 0.10" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1" />
  </joint>
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.20" />
      <geometry>
        <cylinder radius="0.045" length="0.40" />
      </geometry>
      <material name="orange" />
    </visual>
    <collision>
      <origin xyz="0 0 0.2" />
      <geometry>
        <cylinder radius="0.045" length="0.4" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.2" />
      <mass value="1.0" />
      <inertia ixx="0.01383958" ixy="0" ixz="0" iyy="0.01383958" iyz="0" izz="0.00101250" />
    </inertial>
  </link>
  <joint name="joint2" type="revolute">
    <parent link="link1" />
    <child link="link2" />
    <origin xyz="0 0 0.40" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1" />
  </joint>
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.15" />
      <geometry>
        <cylinder radius="0.035" length="0.30" />
      </geometry>
      <material name="blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0.15" />
      <geometry>
        <cylinder radius="0.035" length="0.3" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.15" />
      <mass value="0.6" />
      <inertia ixx="0.00468375" ixy="0" ixz="0" iyy="0.00468375" iyz="0" izz="0.00036750" />
    </inertial>
  </link>
  <joint name="joint3" type="revolute">
    <parent link="link2" />
    <child link="link3" />
    <origin xyz="0 0 0.30" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1" />
  </joint>
  <link name="link3">
    <visual>
      <origin xyz="0 0 0.10" />
      <geometry>
        <cylinder radius="0.025" length="0.20" />
      </geometry>
      <material name="orange" />
    </visual>
    <collision>
      <origin xyz="0 0 0.1" />
      <geometry>
        <cylinder radius="0.025" length="0.2" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.1" />
      <mass value="0.3" />
      <inertia ixx="0.00104688" ixy="0" ixz="0" iyy="0.00104688" iyz="0" izz="0.00009375" />
    </inertial>
  </link>
  <link name="world" />
  <joint name="world_fixed" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0 0 0.5" rpy="0 0 0" />
  </joint>
</robot>