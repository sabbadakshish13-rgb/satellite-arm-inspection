<?xml version="1.0"?>
<sdf version="1.9">
  <model name="inspection_target">
    <static>true</static>
    <pose>0.65 0 0.75 0 0 0</pose>

    <link name="panel">
      <visual name="panel_visual">
        <geometry>
          <box>
            <size>0.4 0.4 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.2 0.8 1</ambient>
          <diffuse>0.1 0.2 0.8 1</diffuse>
        </material>
      </visual>

      <collision name="panel_collision">
        <geometry>
          <box>
            <size>0.4 0.4 0.04</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name="inspection_marker">
      <pose>0 0 0.035 0 0 0</pose>
      <visual name="marker_visual">
        <geometry>
          <sphere>
            <radius>0.06</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="marker_fixed" type="fixed">
      <parent>panel</parent>
      <child>inspection_marker</child>
    </joint>
  </model>
</sdf>
